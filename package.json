{
  "name": "tabletop-party-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --config vite.super.config.ts && vite build --config vite.dinner.config.ts && vite build --config vite.cartographers.config.ts && vite build --config vite.scout.config.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ci": "node --experimental-strip-types --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/test-ci-reporter.mjs --test-reporter-destination=stdout tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "package:offline": "npm run build && node scripts/package-offline.mjs && node scripts/verify-package.mjs",
    "format": "prettier --write src tests/*.test.ts scripts/*.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "prettier": "^3.6.2",
    "typescript": "6.0.2",
    "vite": "8.0.12"
  }
}
